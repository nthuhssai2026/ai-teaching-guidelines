# 複製成 .env 後填入（.env 不會進 Git）
PROVIDER=anthropic        # anthropic 或 openai
API_KEY=                  # 到 console.anthropic.com（或 platform.openai.com）申請，貼在等號後面
MODEL=claude-sonnet-4-5   # openai 可填 gpt-5
PASSCODE=                 # 中心發給老師的共用通行碼；留空＝不驗證（只建議本機測試時）
DAILY_LIMIT=40            # 每日呼叫次數上限
PORT=8787
MAX_TOKENS=6000
